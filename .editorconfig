root = true

# House C# style, build-enforced (EnforceCodeStyleInBuild is on in Directory.Build.props). Adopted from Yalbuz on
# 2026-09-14 with all 13 rules of .claude/rules/coding-style.md; the reasons each severity was chosen are Yalbuz's
# and are not repeated here.

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = crlf

[*.cs]
indent_style = space
indent_size = 4

# --- Pattern matching (rules 5, 6)
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_not_pattern = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
csharp_style_conditional_delegate_call = true:warning

# --- Unused usings (requires GenerateDocumentationFile; see Directory.Build.props)
dotnet_diagnostic.IDE0005.severity = warning

# --- Rule 1: explicit types, never var; target-typed new
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
# --- Rule 2: braces on every block
csharp_prefer_braces = true:warning
# --- Rule 8: range operators
csharp_style_prefer_range_operator = true:warning
# --- Rule 7: collection expressions
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
# --- Rule 11: primary constructors
csharp_style_prefer_primary_constructors = true:warning
dotnet_diagnostic.IDE0290.severity = warning
# --- Rule 10: file-scoped namespaces, block-bodied members
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_expression_bodied_properties = false:warning
csharp_style_expression_bodied_accessors = false:warning
csharp_style_expression_bodied_indexers = false:warning
csharp_style_expression_bodied_methods = false:warning

# --- Code metrics, off at SDK defaults and forced on
dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1505.severity = warning
dotnet_diagnostic.CA1506.severity = warning

# --- Security and disposal rules off at SDK defaults
dotnet_diagnostic.CA2100.severity = warning
dotnet_diagnostic.CA3003.severity = warning
dotnet_diagnostic.CA1001.severity = warning
# CA2000 an IDisposable that leaves scope undisposed. On at zero since 2026-11-07: it was recorded as never firing,
# but the probe was the wrong shape (`FileStream s = new(path, FileMode.Open); return s.Length;` is a case the
# rule does not flag); a StreamReader, an HttpClient or any IDisposable left undisposed does. Every FileStream in
# the tree is under `using`, which the rule cannot vouch for and a reader has to.
dotnet_diagnostic.CA2000.severity = warning

# --- Robustness rules switched on at ZERO, so the next site is new (adopted from Yalbuz 2026-11-07). Each was off
# at SDK defaults, so a sweep reading it measured nothing: a rule that is off reads exactly like a rule at zero.
# Each was proven to FIRE by a probe file before being trusted, and none has a site in this tree today.
# CA1031 a broad `catch (Exception)` with no filter: all six in the tree carry one (the per-workflow and per-map
# guards, IrStage, ExtractionRun's listed and last-resort catches), so the next unfiltered one is new. CA2016 a CancellationToken a method has but does not pass on; CA2201 throwing
# Exception and the other reserved types; CA2008 a task started without a TaskScheduler; CA1065 an exception
# thrown where none is expected (a getter, Equals, GetHashCode, Dispose); CA2219 an exception thrown from finally.
# The SECURITY category is on whole rather than rule by rule (CA2100 and CA3003 above are in it), so a rule a
# future SDK adds arrives on rather than silently off.
dotnet_diagnostic.CA1031.severity = warning
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA2201.severity = warning
dotnet_diagnostic.CA2008.severity = warning
dotnet_diagnostic.CA1065.severity = warning
dotnet_diagnostic.CA2219.severity = warning
dotnet_analyzer_diagnostic.category-Security.severity = warning

# --- The culture-sensitive string family. This tool folds Turkish text for comparison keys (handout §5.2), where
# the dotted/dotless I makes a culture comparison and an ordinal one disagree on real data.
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1307.severity = warning
dotnet_diagnostic.CA1310.severity = warning

# --- Roslynator, three rules only: RCS1211 is rule 13 (no else after a branch that exits).
roslynator_analyzers.enabled_by_default = false
dotnet_analyzer_diagnostic.category-roslynator.severity = none
dotnet_diagnostic.RCS1211.severity = warning
# RCS1236 is rule 9 — an exception FILTER rather than catch-and-retest. It implements HALF of it: it fires on the
# negated retest `if (!(e is X)) throw;` and NOT on the inverted `if (e is X) return; throw;` (both probed in
# Yalbuz). RCS1075 is an empty `catch (Exception)`: CA1031 catches the breadth, this the silence.
dotnet_diagnostic.RCS1236.severity = warning
dotnet_diagnostic.RCS1075.severity = warning

dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

# Banned APIs are architectural boundaries (the read-only guarantee among them), so RS0030 stops the build.
dotnet_diagnostic.RS0030.severity = error

# --- Test project scoping. These sections come LAST: later matching sections win, and [*.cs] above would
# otherwise take the settings back silently.
[Crm.Tests/**.cs]
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1506.severity = none
dotnet_diagnostic.CA2100.severity = none
csharp_style_expression_bodied_methods = false:silent
