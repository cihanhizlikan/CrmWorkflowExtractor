{
  "Crm": {
    "WebApiBaseUrl": "",
    "Authentication": "Default",
    "AuthenticationScheme": "Negotiate",
    "UserName": "",
    "Domain": "",
    "Password": "__CRM_PASSWORD__",
    "CredentialTarget": "CrmWorkflowExtractor",
    "PageSize": 20,
    "MaxAttempts": 5,
    "RequestTimeoutSeconds": 300
  },
  "Output": {
    "Root": "out"
  },
  "Run": {
    "RequireOrganizationReadPrivileges": true,
    "ReprocessRunId": ""
  },
  "Similarity": {
    "StructuralWeight": 0.6,
    "LexicalWeight": 0.4,
    "PathWeight": 0.6,
    "ShingleWeight": 0.4,
    "PrefixWeight": 0.4,
    "TokenJaccardWeight": 0.3,
    "JaroWinklerWeight": 0.3,
    "ClusterThreshold": 0.75,
    "PairFloor": 0.4,
    "CohesionMargin": 0.2,
    "RareTokenMinWorkflows": 2,
    "MaxPathsPerWorkflow": 512
  }
}
